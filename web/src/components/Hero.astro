    <span class="font-brand text-3xl sm:text-4xl text-white tracking-normal select-none inline-block">
      YTcut
    </span>
  </div>

  <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-zinc-100 leading-tight">
    Trim YouTube videos
    <br />
