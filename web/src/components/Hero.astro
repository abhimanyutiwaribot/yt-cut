---
// src/components/Hero.astro
---

<div class="text-center max-w-xl mx-auto mb-10">
  {/* Minimal Wordmark Pill */}
  <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-zinc-900/80 border border-white/[0.08] mb-6 shadow-sm">
    <span class="font-bold text-xs text-white tracking-tight">YT</span>
    <span class="text-zinc-500 font-mono text-[11px]">—</span>
    <span class="font-bold text-xs text-zinc-400 tracking-tight">CUT</span>
    <span class="text-zinc-600 text-[10px] mx-1">·</span>
    <span class="text-[11px] text-zinc-400 font-normal">In-Browser Trimmer</span>
  </div>

  <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-zinc-100 leading-tight">
    Precision video trimming.
    <br class="hidden sm:block" />
    <span class="text-zinc-400 font-normal"> Right in your browser.</span>
  </h1>
  <p class="text-xs sm:text-sm text-zinc-400 mt-3 font-normal max-w-md mx-auto leading-relaxed">
    Lossless excerpt cutting up to 4K resolution. Zero sign-up, zero server queues, zero media stored.
  </p>
</div>
