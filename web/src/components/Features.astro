---
// src/components/Features.astro
---

<section class="mt-14 pt-8 border-t border-white/[0.06]">
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8">
    <div class="space-y-1.5">
      <div class="text-sm font-medium text-zinc-200 flex items-center gap-2">
        <svg class="w-4 h-4 text-zinc-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>Instant & Free</span>
      </div>
      <p class="text-xs text-zinc-400 leading-relaxed">
        Just paste a link and trim. No sign-ups, no wait times, and no software to install.
      </p>
    </div>

    <div class="space-y-1.5">
      <div class="text-sm font-medium text-zinc-200 flex items-center gap-2">
        <svg class="w-4 h-4 text-zinc-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Original Quality</span>
      </div>
      <p class="text-xs text-zinc-400 leading-relaxed">
        Save clips in full resolution up to 4K or extract clear audio with zero blur or quality loss.
      </p>
    </div>

    <div class="space-y-1.5">
      <div class="text-sm font-medium text-zinc-200 flex items-center gap-2">
        <svg class="w-4 h-4 text-zinc-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>100% Private</span>
      </div>
      <p class="text-xs text-zinc-400 leading-relaxed">
        Trimming happens entirely on your own device. Your videos are never saved to a server.
      </p>
    </div>
  </div>
</section>
