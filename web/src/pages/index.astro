---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import Cutter from '../components/Cutter';
import Features from '../components/Features.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';

const title = "YT—CUT · Precision YouTube Video Trimmer (Up to 4K)";
const description = "Lossless, in-browser YouTube video trimmer. Paste any link, drag to isolate timestamps, and export clean 4K/1080p clips directly on your device with zero server storage.";
const siteUrl = "https://yt-cut.com";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    {/* Typography: Geist + Geist Mono from Google Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    {/* Open Graph / Social */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {/* Structured FAQ Data for SEO */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does YT—CUT trim YouTube clips in the browser?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "YT—CUT fetches the exact stream chunks required for your clip range directly to your browser, where WebAssembly-powered FFmpeg executes a lossless stream copy (-c copy) to generate a clean MP4 file in memory."
          }
        },
        {
          "@type": "Question",
          "name": "Is there any generational quality loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. By utilizing direct stream copying rather than re-encoding, frames and audio samples are preserved bit-for-bit with original YouTube fidelity."
          }
        },
        {
          "@type": "Question",
          "name": "Are video files stored on your servers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Zero bytes are stored. Video bytes flow ephemerally through an edge proxy and are processed strictly inside your device's browser memory."
          }
        }
      ]
    })} />
  </head>
  <body class="bg-[#09090b] text-[#fafafa] flex flex-col min-h-screen selection:bg-white/15">
    {/* Subtle radial illumination */}
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="absolute -top-[300px] left-1/2 -translate-x-1/2 w-[900px] h-[600px] bg-gradient-to-b from-white/[0.035] via-white/[0.01] to-transparent blur-3xl rounded-full"></div>
    </div>

    {/* Main Application Deck */}
    <main class="relative z-10 flex-1 max-w-3xl mx-auto w-full px-4 sm:px-6 py-12 md:py-16">
      <Hero />
      <Cutter client:load />
      <Features />
      <Faq />
    </main>

    <Footer />
  </body>
</html>
