---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import Cutter from '../components/Cutter';
import Features from '../components/Features.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';

const title = "YTcut · Precision In-Browser YouTube Video Trimmer";
const description = "Lossless, in-browser YouTube video trimmer. Paste any link, drag to isolate timestamps, and export clean 4K/1080p clips directly on your device with zero server storage.";
const siteUrl = "https://yt-cut.com";
---

<html lang="en" class="dark" style="color-scheme: dark;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    {/* Typography: Geist, Geist Mono, and Calligraphy brand fonts from Google Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600;700&family=Kaushan+Script&family=Satisfy&family=Great+Vibes&display=swap" rel="stylesheet" />

    {/* Open Graph / Social */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {/* Structured FAQ Data for SEO */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do I need to create an account?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. There are no sign-ups, logins, or subscriptions. You can paste a link, trim your clip, and download it right away."
          }
        },
        {
          "@type": "Question",
          "name": "How long can my clips be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can trim clips up to 10 minutes long from videos of any length, including multi-hour podcasts and livestreams."
          }
        },
        {
          "@type": "Question",
          "name": "Does trimming reduce video quality?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Your clip is exported in the video's original resolution (up to 4K) without re-compression or blurring."
          }
        },
        {
          "@type": "Question",
          "name": "Are my videos stored or uploaded anywhere?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Never. All trimming runs directly inside your web browser. Your video bytes are never saved on a server."
          }
        }
      ]
    })} />
  </head>
  <body class="bg-[#09090b] text-[#fafafa] flex flex-col min-h-screen selection:bg-white/15">
    {/* Subtle radial illumination */}
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="absolute -top-[300px] left-1/2 -translate-x-1/2 w-[900px] h-[600px] bg-gradient-to-b from-white/[0.035] via-white/[0.01] to-transparent blur-3xl rounded-full"></div>
    </div>

    {/* Main Application Deck */}
    <main class="relative z-10 flex-1 max-w-3xl mx-auto w-full px-4 sm:px-6 py-12 md:py-16">
      <Hero />
      <Cutter client:load />
      <Features />
      <Faq />
    </main>

    <Footer />
  </body>
</html>
